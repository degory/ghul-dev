use IO.Std.write_line;

// >>>
let numbers = [1, 2, 3, 4, 5, 6];

// building a chain of stages runs nothing: peek's action is
// called only as elements are pulled through it
let stages = numbers
    | .peek(x => write_line("  pulled {x}"))
    | .filter(x => x % 2 == 0)
    | .map(x => x * 10);

write_line("chain built - nothing has run yet");

// collect_list is a terminal, so this is what pulls
let result = stages | .collect_list();

write_line("result: {result | .join(", ")}");
// <<<
