use IO.Std.write_line

// >>>
class RECTANGLE(width: int, height: int) is
    // a method body ends the same way a function body does
    area() -> int is
        width * height
    si

    // return works in a body as well as a tail does
    describe() -> string is
        let label = "{width}x{height}"

        return "{label} = {area()}"
    si
si
// <<<

write_line(RECTANGLE(3, 4).describe())
