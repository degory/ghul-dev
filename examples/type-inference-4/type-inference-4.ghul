use IO.Std.write_line;

class Animal abstract is si

class CAT(): Animal is
    purr() -> string => "purr";
si

// >>>
class CARRIER(occupant: Animal);
// <<<

// >>>
describe(carrier: CARRIER) is
    if isa CAT(carrier.occupant) then
        // an isa test written against a member-access
        // path does not narrow it, so
        // carrier.occupant.purr() would not compile
        // here
        write_line("the carrier holds a cat");
    fi
si
// <<<

entry() is
    describe(CARRIER(CAT()));
si
