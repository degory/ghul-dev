use IO.Std.write_line
use Ghul.Pipes

// >>>
// a comprehension builds its whole array before anything reads it,
// so a sequence that never ends stays a pipe, bounded by take
let squares = from(1) |> map(n => n * n) |> take(5)
write_line("squares: {squares}")

// a bounded pipe can be the source of a comprehension
let odd_squares = [s for s in squares if s % 2 == 1]
write_line("odd squares: {odd_squares}")
// <<<
