use IO.Std.write_line
use Ghul.Pipes

// >>>
// don't write a comprehension over a sequence that never ends: it would
// never finish. Use a pipe, and take the elements you need
let squares = from(1) |> map(n => n * n) |> take(5)
write_line("squares: {squares}")

// keep the odd ones from the five squares the pipe produced
let odd_squares = [s for s in squares if s % 2 == 1]
write_line("odd squares: {odd_squares}")
// <<<
