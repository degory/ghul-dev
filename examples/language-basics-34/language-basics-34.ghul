use IO.Std.write_line
use Ghul.Pipes.join

// >>>
let xs = [10, 20, 30, 40, 50]

write_line(xs[1..3] |> join(", "))     // 20, 30
write_line(xs[1..<1] |> join(", "))    // up to one back from the end
write_line(xs[1..<0] |> join(", "))    // to the end
write_line(xs[3..<<0] |> join(", "))   // the last three

write_line("hello, world"[7..<0])      // a string gives back a string
// <<<
