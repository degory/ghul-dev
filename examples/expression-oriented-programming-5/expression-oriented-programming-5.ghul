use IO.Std.write_line;

// >>>
grade(score: int) -> string is
    // a block as a let initializer, composing a case and an if:
    let label = (
        let band =
            case score / 10
            when 10, 9 then "A"
            when 8 then "B"
            when 7 then "C"
            else "F"
            esac;

        if band == "F" then "fail" else "pass ({band})" fi
    );

    return label;
si

write_line(grade(95));
write_line(grade(82));
write_line(grade(60));
// <<<
