use Collections.Iterable;
use Collections.LIST;
use Collections.MAP;
use Collections.SET;
use Ghul.Pipes.INDEXED_VALUE;

trait Pipe[T] is
// >>>
    append_to(
        into: System.Text.StringBuilder,
        separator: string
    ) -> System.Text.StringBuilder;

    append_to(
        into: System.Text.StringBuilder
    ) -> System.Text.StringBuilder;
// <<<
si

entry() is si
