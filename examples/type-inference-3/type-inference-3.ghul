use IO.Std.write_line;

class Animal abstract is si

class CAT(): Animal is
    purr() -> string => "purr";
si

// >>>
greet(a: Animal) is
    if isa CAT(a) then
        // a is a parameter of greet, narrowed to CAT
        // in this branch
        write_line(a.purr());
    fi
si
// <<<

entry() is
    greet(CAT());
si
