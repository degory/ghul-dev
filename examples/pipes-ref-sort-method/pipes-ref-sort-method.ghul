use Collections.Iterable
use Collections.LIST
use Collections.MAP
use Collections.SET
use Ghul.Pipes.INDEXED_VALUE

trait Pipe[T] is
// >>>
    sort() -> Pipe[T] pure

    sort(comparer: Collections.IComparer[T]) -> Pipe[T] pure

    sort(compare: (T, T) -> int pure) -> Pipe[T] pure
// <<<
si

entry() is si
