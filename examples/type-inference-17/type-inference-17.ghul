class BOX[T] is
    _value: T

    init() is
        _value = _
    si

    set(value: T) is
        _value = value
    si

    get() -> T => _value
si

// >>>
// m is BOX[?] here; the type argument is not
// yet known
let m = BOX()

// the set call takes an int, so m is BOX[int]
m.set(42)

let x = m.get()
// <<<
