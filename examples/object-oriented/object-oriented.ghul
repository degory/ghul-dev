use IO.Std.write_line;
use Ghul.Pipes.Pipe;

// a series knows its own name and how to produce its
// values; behaviour written in terms of those two is
// inherited by every subclass:
class Series is
    _name: string;

    init(name: string) is
        _name = name;
    si

    name: string => _name;

    // body-less: Series is implicitly abstract, and
    // each subclass supplies the values
    values() -> Pipe[int];

    summary() -> string =>
        "first 10 {name} numbers: {values() | .take(10)}";
si

// lazily generates an infinite sequence of
// fibonacci numbers:
class FIBONACCI: Series is
    init() is super.init("fibonacci"); si

    values() -> Pipe[int] is
        let prev mut = 1;
        let current mut = 1;
        do
            yield current;
            let next = prev + current;
            prev = current;
            current = next;
        od
    si
si

// lazily generates an infinite sequence of
// factorials:
class FACTORIAL: Series is
    init() is super.init("factorial"); si

    values() -> Pipe[int] is
        let n mut = 1;
        let prev mut = 1;
        do
            n = n + 1;
            prev = prev * n;
            yield prev;
        od
    si
si

let fibonacci = FIBONACCI();
let factorial = FACTORIAL();

let sequences: Series[] = [fibonacci, factorial];

// summary is inherited, and the values() it calls
// dispatches on each object's own type:
for series in sequences do
    write_line(series.summary());
od

let first_10_even =
    fibonacci.values()
        | .filter(x => x % 2 == 0)
        .take(10);

write_line(
    "first 10 even fibonacci numbers: {first_10_even}"
);

let indexed =
    fibonacci.values()
        | .zip(factorial.values())
        .take(10)
        .index();

for (i, (fib, fact)) in indexed do
    write_line("fibonacci {i} is {fib}");
    write_line("factorial {i} is {fact}");
od;
