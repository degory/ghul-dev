use IO.Std.write_line;

class Animal abstract is
    name() -> string;
si

class CAT: Animal is
    init() is si
    name() -> string => "cat";
    purr() -> string => "purr";
si

any_animal() -> Animal => CAT();

entry() is
    let pet mut = any_animal();
// >>>
    pet = CAT();
    // assigning a CAT narrows pet to CAT, so purr() is in reach
    write_line(pet.purr());
// <<<
si
