use IO.Std.write_line

class CAT is
    name: string
    is_friendly: bool
    init(name: string, is_friendly: bool) is
        self.name = name
        self.is_friendly = is_friendly
    si
si

find() -> CAT? => CAT("Tom", true)

// >>>
if let c: CAT = find() /\ c.is_friendly then
    write_line("friendly cat: {c.name}")
fi
// <<<
