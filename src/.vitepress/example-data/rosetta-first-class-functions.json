{
  "name": "rosetta-first-class-functions",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Ghul.Pipes;\nuse Collections.LIST;\nuse System.Math;\n\n>>[A, B, C](f: A -> B, g: B -> C) -> A -> C =>\n    x => g(f(x));\n\nlet cube = x => x * x * x;\nlet cube_root = x => Math.cbrt(x);\n\nlet functions = LIST();\nfunctions.add(Math.sin);\nfunctions.add(Math.cos);\nfunctions.add(cube);\n\nlet inverses = LIST();\ninverses.add(Math.asin);\ninverses.add(Math.acos);\ninverses.add(cube_root);\n\nfor (function, inverse) in functions |> zip(inverses) do\n    let round_trip = function >> inverse;\n\n    write_line(\"{round_trip(0.5D):F6}\");\nod",
  "fullSource": "use IO.Std.write_line;\nuse Ghul.Pipes;\nuse Collections.LIST;\nuse System.Math;\n\n>>[A, B, C](f: A -> B, g: B -> C) -> A -> C =>\n    x => g(f(x));\n\nlet cube = x => x * x * x;\nlet cube_root = x => Math.cbrt(x);\n\nlet functions = LIST();\nfunctions.add(Math.sin);\nfunctions.add(Math.cos);\nfunctions.add(cube);\n\nlet inverses = LIST();\ninverses.add(Math.asin);\ninverses.add(Math.acos);\ninverses.add(cube_root);\n\nfor (function, inverse) in functions |> zip(inverses) do\n    let round_trip = function >> inverse;\n\n    write_line(\"{round_trip(0.5D):F6}\");\nod\n",
