{
  "name": "rosetta-first-class-functions",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.LIST;\nuse System.Math;\n\n// a compose function\n>>[A, B, C](f: A -> B, g: B -> C) -> A -> C =>\n    x => g(f(x));\n\n// some simple functions\nlet cube = x => x * x * x;\nlet cube_root = x => Math.cbrt(x);\n\n// store the functions in a list\nlet functions = LIST();\nfunctions.add(Math.sin);\nfunctions.add(Math.cos);\nfunctions.add(cube);\n\nlet inverses = LIST();\ninverses.add(Math.asin);\ninverses.add(Math.acos);\ninverses.add(cube_root);\n\nfor i in 0..functions.count do\n    // compose each function with its inverse\n    let round_trip = inverses[i] >> functions[i];\n\n    // we expect that round_trip(x) == x for all x\n    // in the domain of the function\n    write_line(\"{round_trip(0.5D):F6}\");\nod",
  "fullSource": "use IO.Std.write_line;\nuse Collections.LIST;\nuse System.Math;\n\n// a compose function\n>>[A, B, C](f: A -> B, g: B -> C) -> A -> C =>\n    x => g(f(x));\n\n// some simple functions\nlet cube = x => x * x * x;\nlet cube_root = x => Math.cbrt(x);\n\n// store the functions in a list\nlet functions = LIST();\nfunctions.add(Math.sin);\nfunctions.add(Math.cos);\nfunctions.add(cube);\n\nlet inverses = LIST();\ninverses.add(Math.asin);\ninverses.add(Math.acos);\ninverses.add(cube_root);\n\nfor i in 0..functions.count do\n    // compose each function with its inverse\n    let round_trip = inverses[i] >> functions[i];\n\n    // we expect that round_trip(x) == x for all x\n    // in the domain of the function\n    write_line(\"{round_trip(0.5D):F6}\");\nod\n",
