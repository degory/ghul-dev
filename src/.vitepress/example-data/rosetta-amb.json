  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.Iterable;\nuse Collections.List;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// Takes one value from each set in turn and yields the sequences the constraint accepts. It is a\n// generator, so a sequence is only built when one is asked for, and a caller that wants a single\n// success stops the search as soon as it has one.\namb[T](sets: List[Iterable[T]], accepts: (T, T) -> bool pure) -> Pipe[LIST[T]] is\n    if sets.count == 0 then\n        yield LIST[T]();\n    else\n        for choice in sets[0] do\n            for rest in amb(sets |> skip(1) |> collect(), accepts) do\n                if rest.count == 0 \\/ accepts(choice, rest[0]) then\n                    let sequence = LIST[T]();\n\n                    sequence.add(choice);\n                    sequence.add_range(rest);\n\n                    yield sequence;\n                fi\n            od\n        od\n    fi\nsi\n\nlet sets: List[Iterable[string]] = [\n    [\"the\", \"that\", \"a\"],\n    [\"frog\", \"elephant\", \"thing\"],\n    [\"walked\", \"treaded\", \"grows\"],\n    [\"slowly\", \"quickly\"]\n];\n\nfor sentence in amb(sets, (left, right) => left[left.length - 1] == right[0]) do\n    write_line(sentence |> join(\" \"));\nod",
  "fullSource": "use IO.Std.write_line;\nuse Collections.Iterable;\nuse Collections.List;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// Takes one value from each set in turn and yields the sequences the constraint accepts. It is a\n// generator, so a sequence is only built when one is asked for, and a caller that wants a single\n// success stops the search as soon as it has one.\namb[T](sets: List[Iterable[T]], accepts: (T, T) -> bool pure) -> Pipe[LIST[T]] is\n    if sets.count == 0 then\n        yield LIST[T]();\n    else\n        for choice in sets[0] do\n            for rest in amb(sets |> skip(1) |> collect(), accepts) do\n                if rest.count == 0 \\/ accepts(choice, rest[0]) then\n                    let sequence = LIST[T]();\n\n                    sequence.add(choice);\n                    sequence.add_range(rest);\n\n                    yield sequence;\n                fi\n            od\n        od\n    fi\nsi\n\nlet sets: List[Iterable[string]] = [\n    [\"the\", \"that\", \"a\"],\n    [\"frog\", \"elephant\", \"thing\"],\n    [\"walked\", \"treaded\", \"grows\"],\n    [\"slowly\", \"quickly\"]\n];\n\nfor sentence in amb(sets, (left, right) => left[left.length - 1] == right[0]) do\n    write_line(sentence |> join(\" \"));\nod\n",
