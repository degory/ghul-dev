{
  "name": "rosetta-variadic-function",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// ghūl has no variadic functions. A function that takes any number of values\n// takes an array, and the caller writes an array literal at the call site.\nprint_all(values: object[]) is\n    for value in values do\n        write_line(\"{value}\");\n    od\nsi\n\nclass Animal(name: string) abstract is\n    speak() -> string;\n\n    to_string() -> string => \"{name} says {speak()}\";\nsi\n\nclass CAT(name: string): Animal is\n    super(name);\n\n    speak() -> string => \"meow\";\nsi\n\nclass DOG(name: string): Animal is\n    super(name);\n\n    speak() -> string => \"woof\";\nsi\n\nherd(animals: Animal[]) is\n    for animal in animals do\n        write_line(\"{animal}\");\n    od\nsi\n\nprint_all([\"one\", 2, 3.5]);\n\n// the element type of an array literal is inferred as the nearest type the\n// elements have in common, so a literal mixing cats and dogs is an Animal[]\nherd([CAT(\"felix\"), DOG(\"rex\")]);\n\n// the array can be built at run time instead\nlet animals = LIST[Animal]();\nanimals.add(CAT(\"tom\"));\nanimals.add(DOG(\"spot\"));\n\nherd(animals |> collect_array());",
  "fullSource": "use IO.Std.write_line;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// ghūl has no variadic functions. A function that takes any number of values\n// takes an array, and the caller writes an array literal at the call site.\nprint_all(values: object[]) is\n    for value in values do\n        write_line(\"{value}\");\n    od\nsi\n\nclass Animal(name: string) abstract is\n    speak() -> string;\n\n    to_string() -> string => \"{name} says {speak()}\";\nsi\n\nclass CAT(name: string): Animal is\n    super(name);\n\n    speak() -> string => \"meow\";\nsi\n\nclass DOG(name: string): Animal is\n    super(name);\n\n    speak() -> string => \"woof\";\nsi\n\nherd(animals: Animal[]) is\n    for animal in animals do\n        write_line(\"{animal}\");\n    od\nsi\n\nprint_all([\"one\", 2, 3.5]);\n\n// the element type of an array literal is inferred as the nearest type the\n// elements have in common, so a literal mixing cats and dogs is an Animal[]\nherd([CAT(\"felix\"), DOG(\"rex\")]);\n\n// the array can be built at run time instead\nlet animals = LIST[Animal]();\nanimals.add(CAT(\"tom\"));\nanimals.add(DOG(\"spot\"));\n\nherd(animals |> collect_array());\n",
  "hiddenBefore": false,
