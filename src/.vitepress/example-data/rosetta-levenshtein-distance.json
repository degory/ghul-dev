{
  "name": "rosetta-levenshtein-distance",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.LIST;\nuse System.Math.min;\n\n// One row of the edit-distance matrix at a time: `previous` holds the row for the prefix of the\n// source one character shorter than the one being filled in.\nlevenshtein(source: string, target: string) -> int is\n    let previous mut = LIST();\n\n    for j in 0::target.length do\n        previous.add(j);\n    od\n\n    for i in 1::source.length do\n        let current = LIST();\n\n        current.add(i);\n\n        for j in 1::target.length do\n            let substitution =\n                previous[j - 1] + if source[i - 1] == target[j - 1] then 0 else 1 fi;\n\n            current.add(min(substitution, min(previous[j] + 1, current[j - 1] + 1)));\n        od\n\n        previous = current;\n    od\n\n    return previous[target.length];\nsi\n\nwrite_line(\"{levenshtein(\"kitten\", \"sitting\")}\");\nwrite_line(\"{levenshtein(\"rosettacode\", \"raisethysword\")}\");",
  "fullSource": "use IO.Std.write_line;\nuse Collections.LIST;\nuse System.Math.min;\n\n// One row of the edit-distance matrix at a time: `previous` holds the row for the prefix of the\n// source one character shorter than the one being filled in.\nlevenshtein(source: string, target: string) -> int is\n    let previous mut = LIST();\n\n    for j in 0::target.length do\n        previous.add(j);\n    od\n\n    for i in 1::source.length do\n        let current = LIST();\n\n        current.add(i);\n\n        for j in 1::target.length do\n            let substitution =\n                previous[j - 1] + if source[i - 1] == target[j - 1] then 0 else 1 fi;\n\n            current.add(min(substitution, min(previous[j] + 1, current[j - 1] + 1)));\n        od\n\n        previous = current;\n    od\n\n    return previous[target.length];\nsi\n\nwrite_line(\"{levenshtein(\"kitten\", \"sitting\")}\");\nwrite_line(\"{levenshtein(\"rosettacode\", \"raisethysword\")}\");\n",
