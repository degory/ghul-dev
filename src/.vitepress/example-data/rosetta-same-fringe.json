  "name": "rosetta-same-fringe",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\nunion Tree is\n    LEAF(value: int);\n    NODE(left: Tree, right: Tree);\nsi\n\nuse Tree.LEAF;\nuse Tree.NODE;\n\n// A generator, so a leaf is produced only when one is asked for. Nothing walks a whole tree\n// unless a caller keeps asking to the end of it.\nfringe(tree: Tree) -> Pipe[int] is\n    if isa LEAF(tree) then\n        yield tree.value;\n    elif isa NODE(tree) then\n        for leaf in fringe(tree.left) do\n            yield leaf;\n        od\n\n        for leaf in fringe(tree.right) do\n            yield leaf;\n        od\n    fi\nsi\n\n// Pulls one leaf from each tree at a time and stops at the first pair that differs, so the count\n// it reports is how much of the two trees had to be looked at.\ncompare(a: Tree, b: Tree) -> (same: bool, leaves: int) is\n    let left = fringe(a).iterator;\n    let right = fringe(b).iterator;\n\n    let leaves mut = 0;\n\n    do\n        let more_left = left.move_next();\n        let more_right = right.move_next();\n\n        if more_left != more_right then\n            return (false, leaves);\n        fi\n\n        if !more_left then\n            return (true, leaves);\n        fi\n\n        leaves = leaves + 1;\n\n        if left.current != right.current then\n            return (false, leaves);\n        fi\n    od\nsi\n\nshow(tree: Tree) -> string =>\n    case tree\n    when (value): LEAF then \"{value}\"\n    when (left, right): NODE then \"({show(left)} {show(right)})\"\n    esac;\n\nlet leaning_left = NODE(NODE(LEAF(1), LEAF(2)), LEAF(3));\nlet leaning_right = NODE(LEAF(1), NODE(LEAF(2), LEAF(3)));\nlet differs_last = NODE(LEAF(1), NODE(LEAF(2), LEAF(4)));\nlet differs_first = NODE(NODE(LEAF(9), LEAF(2)), LEAF(3));\nlet shorter = NODE(LEAF(1), LEAF(2));\n\nfor (a, b) in [\n    (leaning_left, leaning_right),\n    (leaning_left, differs_last),\n    (leaning_left, differs_first),\n    (leaning_left, shorter)\n] do\n    let (same, leaves) = compare(a, b);\n\n    write_line(\n        \"{show(a)} and {show(b)}: {if same then \"same fringe\" else \"different\" fi}, {leaves} {if leaves == 1 then \"leaf\" else \"leaves\" fi} compared\"\n    );\nod",
  "fullSource": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\nunion Tree is\n    LEAF(value: int);\n    NODE(left: Tree, right: Tree);\nsi\n\nuse Tree.LEAF;\nuse Tree.NODE;\n\n// A generator, so a leaf is produced only when one is asked for. Nothing walks a whole tree\n// unless a caller keeps asking to the end of it.\nfringe(tree: Tree) -> Pipe[int] is\n    if isa LEAF(tree) then\n        yield tree.value;\n    elif isa NODE(tree) then\n        for leaf in fringe(tree.left) do\n            yield leaf;\n        od\n\n        for leaf in fringe(tree.right) do\n            yield leaf;\n        od\n    fi\nsi\n\n// Pulls one leaf from each tree at a time and stops at the first pair that differs, so the count\n// it reports is how much of the two trees had to be looked at.\ncompare(a: Tree, b: Tree) -> (same: bool, leaves: int) is\n    let left = fringe(a).iterator;\n    let right = fringe(b).iterator;\n\n    let leaves mut = 0;\n\n    do\n        let more_left = left.move_next();\n        let more_right = right.move_next();\n\n        if more_left != more_right then\n            return (false, leaves);\n        fi\n\n        if !more_left then\n            return (true, leaves);\n        fi\n\n        leaves = leaves + 1;\n\n        if left.current != right.current then\n            return (false, leaves);\n        fi\n    od\nsi\n\nshow(tree: Tree) -> string =>\n    case tree\n    when (value): LEAF then \"{value}\"\n    when (left, right): NODE then \"({show(left)} {show(right)})\"\n    esac;\n\nlet leaning_left = NODE(NODE(LEAF(1), LEAF(2)), LEAF(3));\nlet leaning_right = NODE(LEAF(1), NODE(LEAF(2), LEAF(3)));\nlet differs_last = NODE(LEAF(1), NODE(LEAF(2), LEAF(4)));\nlet differs_first = NODE(NODE(LEAF(9), LEAF(2)), LEAF(3));\nlet shorter = NODE(LEAF(1), LEAF(2));\n\nfor (a, b) in [\n    (leaning_left, leaning_right),\n    (leaning_left, differs_last),\n    (leaning_left, differs_first),\n    (leaning_left, shorter)\n] do\n    let (same, leaves) = compare(a, b);\n\n    write_line(\n        \"{show(a)} and {show(b)}: {if same then \"same fringe\" else \"different\" fi}, {leaves} {if leaves == 1 then \"leaf\" else \"leaves\" fi} compared\"\n    );\nod\n",
