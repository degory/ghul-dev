{
  "name": "rosetta-josephus-problem-02-the-killing-sequence",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\n// Walking the circle for real: the executioner steps k - 1 places past the last one killed, and\n// removing a prisoner closes the gap, so the next count carries on from the same index.\nkillings(n: int, k: int) -> Pipe[int] is\n    let standing = (0..n) |> collect_list();\n    let at mut = 0;\n\n    while standing.count > 1 do\n        at = (at + k - 1) % standing.count;\n\n        yield standing[at];\n\n        standing.remove_at(at);\n    od\nsi\n\nshow(n: int, k: int) is\n    let killed = killings(n, k) |> collect_list();\n\n    write_line(\"n = {n}, k = {k}: killed {killed |> join(\", \")}\");\nsi\n\nshow(5, 2);\nshow(7, 3);",
