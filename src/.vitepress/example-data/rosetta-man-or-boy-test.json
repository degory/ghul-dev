  "code": "use IO.Std.write_line\n\na(\n    k: int,\n    x1: () -> int,\n    x2: () -> int,\n    x3: () -> int,\n    x4: () -> int,\n    x5: () -> int\n) -> int is\n    let counter mut = k\n\n    let b = () rec => (\n        counter = counter - 1\n\n        a(counter, rec, x1, x2, x3, x4)\n    )\n\n    return if counter <= 0 then x4() + x5() else b() fi\nsi\n\nfor k in 0::10 do\n    let result = a(k, () => 1, () => -1, () => -1, () => 1, () => 0)\n\n    write_line(\"k = {k,2}: {result}\")\nod",
