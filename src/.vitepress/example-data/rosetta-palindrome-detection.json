{
  "name": "rosetta-palindrome-detection",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\nreverse(s: string) -> string =>\n    s |> reduce(\"\", (acc, c) => \"{c}{acc}\");\n\nis_palindrome(s: string) -> bool => s =~ reverse(s);\n\n// ignores non-letters and folds case\nis_inexact_palindrome(s: string) -> bool =>\n    s \n        |> filter(char.is_letter)\n        |> map(char.to_lower)\n        |> reduce(\"\", (acc, c) => \"{acc}{c}\")\n        |> is_palindrome();\n\nwrite_line(\"is_palindrome(\\\"racecar\\\"): {is_palindrome(\"racecar\")}\");\nwrite_line(\"is_palindrome(\\\"hello\\\"): {is_palindrome(\"hello\")}\");\nwrite_line(\"is_palindrome(\\\"rotor\\\"): {is_palindrome(\"rotor\")}\");\n\nwrite_line(\"is_inexact_palindrome(\\\"A man, a plan, a canal: Panama\\\"): {is_inexact_palindrome(\"A man, a plan, a canal: Panama\")}\");\nwrite_line(\"is_inexact_palindrome(\\\"race car\\\"): {is_inexact_palindrome(\"race car\")}\");\nwrite_line(\"is_inexact_palindrome(\\\"hello world\\\"): {is_inexact_palindrome(\"hello world\")}\");",
  "fullSource": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\nreverse(s: string) -> string =>\n    s |> reduce(\"\", (acc, c) => \"{c}{acc}\");\n\nis_palindrome(s: string) -> bool => s =~ reverse(s);\n\n// ignores non-letters and folds case\nis_inexact_palindrome(s: string) -> bool =>\n    s \n        |> filter(char.is_letter)\n        |> map(char.to_lower)\n        |> reduce(\"\", (acc, c) => \"{acc}{c}\")\n        |> is_palindrome();\n\nwrite_line(\"is_palindrome(\\\"racecar\\\"): {is_palindrome(\"racecar\")}\");\nwrite_line(\"is_palindrome(\\\"hello\\\"): {is_palindrome(\"hello\")}\");\nwrite_line(\"is_palindrome(\\\"rotor\\\"): {is_palindrome(\"rotor\")}\");\n\nwrite_line(\"is_inexact_palindrome(\\\"A man, a plan, a canal: Panama\\\"): {is_inexact_palindrome(\"A man, a plan, a canal: Panama\")}\");\nwrite_line(\"is_inexact_palindrome(\\\"race car\\\"): {is_inexact_palindrome(\"race car\")}\");\nwrite_line(\"is_inexact_palindrome(\\\"hello world\\\"): {is_inexact_palindrome(\"hello world\")}\");\n",
