  "code": "use default\nuse IO.Std.read_line\nuse System.Random\n\nlet width = 79\nlet height = 22\nlet random = Random(9)\n\nlet grid = LIST[int]((0..width * height) |> map(_ => random.next(1, 10)))\n\nlet directions = MAP[char, (dx: int, dy: int)]()\ndirections['q'] = (-1, -1)\ndirections['w'] = (0, -1)\ndirections['e'] = (1, -1)\ndirections['a'] = (-1, 0)\ndirections['d'] = (1, 0)\ndirections['z'] = (-1, 1)\ndirections['x'] = (0, 1)\ndirections['c'] = (1, 1)\n\nlet x mut = random.next(width)\nlet y mut = random.next(height)\nlet score mut = 0\n\ngrid[y * width + x] = 0\n\ninside(column: int, row: int) -> bool =>\n    column >= 0 /\\ column < width /\\ row >= 0 /\\ row < height\n\nreach(dx: int, dy: int) -> int is\n    if !inside(x + dx, y + dy) then\n        return 0\n    fi\n\n    let steps = grid[(y + dy) * width + x + dx]\n\n    let clear =\n        (1::steps) |> all(i =>\n            inside(x + dx * i, y + dy * i) /\\\n            grid[(y + dy * i) * width + x + dx * i] != 0)\n\n    if clear then steps else 0 fi\nsi\n\nshow() is\n    for row in 0..height do\n        write_line(\n            (0..width)\n                |> map(column =>\n                    if column == x /\\ row == y then \"@\"\n                    elif grid[row * width + column] == 0 then \" \"\n                    else \"{grid[row * width + column]}\"\n                    fi)\n                |> join(\"\"))\n    od\n\n    write_line(\"score {score}\")\nsi\n\ncan_move() -> bool =>\n    directions.values |> any(((dx, dy)) => reach(dx, dy) > 0)\n\nshow()\n\nwhile can_move() do\n    write_line(\"move (q w e / a d / z x c)?\")\n\n    let line = read_line()\n\n    if !line? then\n        break\n    fi\n\n    write_line(\"> {line}\")\n\n    let key = line.trim()\n\n    if key.length != 1 \\/ !directions.contains_key(key[0]) then\n        write_line(\"one of q w e a d z x c, please\")\n        continue\n    fi\n\n    let (dx, dy) = directions[key[0]]\n    let steps = reach(dx, dy)\n\n    if steps == 0 then\n        write_line(\"you can't move that way\")\n        continue\n    fi\n\n    for _ in 0..steps do\n        x = x + dx\n        y = y + dy\n        grid[y * width + x] = 0\n    od\n\n    score = score + steps\n    show()\nod\n\nif !can_move() then\n    write_line(\"no moves left: game over, you ate {score} squares\")\nfi",
