{
  "name": "rosetta-amicable-pairs",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\nlet limit = 20000;\n\nsum_of_proper_divisors(n: int) -> int =>\n    (1::(n / 2)) |> filter(d => n % d == 0) |> reduce(0, (total, d) => total + d);\n\n// Only the smaller member of a pair is searched for, so each pair is reported once and a perfect\n// number, which is its own partner, is not reported at all.\n(1::limit)\n|> map(n => (n, partner = sum_of_proper_divisors(n)))\n|> filter(((n, partner)) => partner > n /\\ sum_of_proper_divisors(partner) == n)\n|> each(((n, partner)) => write_line(\"{n} and {partner}\"));",
