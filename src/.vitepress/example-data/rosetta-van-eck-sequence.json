  "name": "rosetta-van-eck-sequence",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.MAP;\nuse Ghul.Pipes;\n\nvan_eck() -> Pipe[int] is\n    let last_seen = MAP[int, int]();\n\n    let term mut = 0;\n    let position mut = 0;\n\n    do\n        yield term;\n\n        let previous mut = 0;\n        let next =\n            if last_seen.try_get_value(term, previous ref) then\n                position - previous\n            else\n                0\n            fi;\n\n        last_seen[term] = position;\n\n        term = next;\n        position = position + 1;\n    od\nsi\n\nwrite_line(\"first ten:      {van_eck() |> take(10) |> join(\" \")}\");\nwrite_line(\n    \"terms 991-1000: {van_eck() |> skip(990) |> take(10) |> join(\" \")}\");",
