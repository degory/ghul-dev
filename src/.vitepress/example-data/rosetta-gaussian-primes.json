  "code": "use default\n\nis_prime(n: int) -> bool is\n    if n < 2 then\n        return false\n    fi\n\n    if n % 2 == 0 then\n        return n == 2\n    fi\n\n    let i mut = 3\n\n    while i * i <= n do\n        if n % i == 0 then\n            return false\n        fi\n\n        i = i + 2\n    od\n\n    true\nsi\n\nis_gaussian_prime(a: int, b: int) -> bool =>\n    if a != 0 /\\ b != 0 then\n        is_prime(a * a + b * b)\n    elif a != 0 then\n        is_prime(System.Math.abs(a)) /\\ System.Math.abs(a) % 4 == 3\n    elif b != 0 then\n        is_prime(System.Math.abs(b)) /\\ System.Math.abs(b) % 4 == 3\n    else\n        false\n    fi\n\nlet primes_under_100 =\n    (-10::10)\n        |> flat_map(a => (-10::10)\n            |> filter(b => a * a + b * b < 100 /\\ is_gaussian_prime(a, b))\n            |> map(b => (a = a, b = b)))\n        |> collect_list()\n\nlet count = primes_under_100.count\nlet listing = primes_under_100\n    |> map(p => \"{p.a}{if p.b >= 0 then \"+\" else \"\" fi}{p.b}i\")\n    |> join(\", \")\n\nwrite_line(\"gaussian primes with norm < 100 ({count} total):\")\nwrite_line(listing)\nwrite_line(\"\")\nwrite_line(\n    \"plot, radius 50 (rows run from imaginary part +50 down to -50):\"\n)\n\nfor b in (-50::50) |> reverse() do\n    let row = (-50::50)\n        |> map(a => if is_gaussian_prime(a, b) then \"*\" else \" \" fi)\n        |> join(\"\")\n\n    write_line(row)\nod",
