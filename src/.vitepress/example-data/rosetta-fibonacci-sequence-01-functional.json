  "code": "use IO.Std.write_line\nuse Ghul.Pipes\n\nlet fibonacci_sequence = stream(\n    (0, 1),\n    ((previous, current)) =>\n        previous || (current, previous + current)\n)\n\nlet fib = n => fibonacci_sequence |> skip(n) |> first()\n\nfibonacci_sequence\n    |> take(10)\n    |> index()\n    |> each(((position, value)) =>\n        write_line(\"fib({position}) = {value}\"))\n\nwrite_line(\"fib(30) = {fib(30)}\");",
