{
  "name": "rosetta-sorting-algorithms-quicksort",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.List;\nuse Ghul.Pipes;\n\n// The pivot splits the rest into what sorts before it and what sorts after, and those two are\n// sorted the same way. Partitioning with filter says that directly, at the cost of walking the\n// tail twice and building new lists rather than exchanging in place.\nquicksort[T: Ghul.Comparable[T]](values: List[T]) -> List[T] =>\n    if values.count <= 1 then\n        values\n    else\n        val\n            let pivot = values[0];\n            let rest = values |> skip(1) |> collect();\n\n            quicksort(rest |> filter(v => v < pivot) |> collect())\n                |> cat([pivot])\n                |> cat(quicksort(rest |> filter(v => v >= pivot) |> collect()))\n                |> collect()\n        lav\n    fi;\n\nwrite_line(\"{$quicksort([6, 2, 9, 2, 5, 1, 8, 3] |> collect())}\");\nwrite_line(\"{$quicksort([\"pear\", \"apple\", \"fig\", \"date\"] |> collect())}\");",
  "fullSource": "use IO.Std.write_line;\nuse Collections.List;\nuse Ghul.Pipes;\n\n// The pivot splits the rest into what sorts before it and what sorts after, and those two are\n// sorted the same way. Partitioning with filter says that directly, at the cost of walking the\n// tail twice and building new lists rather than exchanging in place.\nquicksort[T: Ghul.Comparable[T]](values: List[T]) -> List[T] =>\n    if values.count <= 1 then\n        values\n    else\n        val\n            let pivot = values[0];\n            let rest = values |> skip(1) |> collect();\n\n            quicksort(rest |> filter(v => v < pivot) |> collect())\n                |> cat([pivot])\n                |> cat(quicksort(rest |> filter(v => v >= pivot) |> collect()))\n                |> collect()\n        lav\n    fi;\n\nwrite_line(\"{$quicksort([6, 2, 9, 2, 5, 1, 8, 3] |> collect())}\");\nwrite_line(\"{$quicksort([\"pear\", \"apple\", \"fig\", \"date\"] |> collect())}\");\n",
