{
  "name": "rosetta-sorting-algorithms-quicksort",
  "snippet": false,
  "code": "use IO.Std.write_line\nuse Collections.List\nuse Ghul.Pipes\n\nquicksort[T: Ghul.Comparable[T]](values: List[T]) -> List[T] =>\n    if values.count <= 1 then\n        values\n    else\n        let pivot = values[0]\n        let rest = values[1..<0]\n\n        let below = rest |> filter(value => value < pivot) |> collect()\n        let above = rest |> filter(value => value >= pivot) |> collect()\n\n        quicksort(below)\n            |> cat([pivot])\n            |> cat(quicksort(above))\n            |> collect()\n    fi\n\nwrite_line(\"{$quicksort([6, 2, 9, 2, 5, 1, 8, 3] |> collect())}\")\nwrite_line(\"{$quicksort([\"pear\", \"apple\", \"fig\", \"date\"] |> collect())}\");",
  "fullSource": "use IO.Std.write_line\nuse Collections.List\nuse Ghul.Pipes\n\nquicksort[T: Ghul.Comparable[T]](values: List[T]) -> List[T] =>\n    if values.count <= 1 then\n        values\n    else\n        let pivot = values[0]\n        let rest = values[1..<0]\n\n        let below = rest |> filter(value => value < pivot) |> collect()\n        let above = rest |> filter(value => value >= pivot) |> collect()\n\n        quicksort(below)\n            |> cat([pivot])\n            |> cat(quicksort(above))\n            |> collect()\n    fi\n\nwrite_line(\"{$quicksort([6, 2, 9, 2, 5, 1, 8, 3] |> collect())}\")\nwrite_line(\"{$quicksort([\"pear\", \"apple\", \"fig\", \"date\"] |> collect())}\");\n",
