{
  "name": "rosetta-van-der-corput-sequence",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections;\nuse Ghul.Pipes;\n\nvan_der_corput(n: int, base: int) -> double pure =>\n    val\n        let rest mut = n;\n        let weight mut = 1.0D / cast(base);\n        let term mut = 0.0D;\n\n        while rest > 0 do\n            term = term + cast(rest % base) * weight;\n\n            rest = rest / base;\n            weight = weight / cast(base);\n        od\n\n        term\n    lav;\n\nlet base_2 = (0::9) |> map(n => \"{van_der_corput(n, 2)}\") |> join(\", \");\n\nwrite_line(\"base 2: {base_2}\");\n\nfor base in 3::5 do\n    let terms = LIST();\n\n    for n in 0::9 do\n        terms.add(\"{van_der_corput(n, base):F4}\");\n    od\n\n    write_line(\"base {base}: {terms |> join(\", \")}\");\nod",
  "fullSource": "use IO.Std.write_line;\nuse Collections;\nuse Ghul.Pipes;\n\nvan_der_corput(n: int, base: int) -> double pure =>\n    val\n        let rest mut = n;\n        let weight mut = 1.0D / cast(base);\n        let term mut = 0.0D;\n\n        while rest > 0 do\n            term = term + cast(rest % base) * weight;\n\n            rest = rest / base;\n            weight = weight / cast(base);\n        od\n\n        term\n    lav;\n\nlet base_2 = (0::9) |> map(n => \"{van_der_corput(n, 2)}\") |> join(\", \");\n\nwrite_line(\"base 2: {base_2}\");\n\nfor base in 3::5 do\n    let terms = LIST();\n\n    for n in 0::9 do\n        terms.add(\"{van_der_corput(n, base):F4}\");\n    od\n\n    write_line(\"base {base}: {terms |> join(\", \")}\");\nod\n",
