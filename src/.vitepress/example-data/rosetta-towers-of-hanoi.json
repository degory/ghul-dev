  "code": "use IO.Std.write_line;\n\nmove(disks: int, source: int, target: int, spare: int) -> void =>\n    if disks > 0 then\n        move(disks - 1, source, spare, target);\n        write_line(\"move a disk from pole {source} to pole {target}\");\n        move(disks - 1, spare, target, source);\n    fi;\n\nmove(3, 1, 3, 2);",
