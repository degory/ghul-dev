{
  "name": "rosetta-water-collected-between-towers",
  "snippet": false,
  "code": "use IO.Std.write_line\nuse Collections.Iterable\nuse Ghul.Pipes\nuse System.Math\n\nrunning_maxima(heights: Iterable[int]) -> Pipe[int] is\n    let highest mut = 0\n\n    for height in heights do\n        highest = Math.max(highest, height)\n\n        yield highest\n    od\nsi\n\nwater(heights: int[]) -> int => (\n    let left = running_maxima(heights) |> collect_list()\n    let right =\n        running_maxima(heights |> reverse()) |> collect_list()\n    let last = heights.count - 1\n\n    (0..heights.count)\n    |> map(i => Math.min(left[i], right[last - i]) - heights[i])\n    |> reduce(0, (total, depth) => total + depth)\n)\n\nlet series: int[][] =\n    [[1, 5, 3, 7, 2],\n     [5, 3, 7, 2, 6, 4, 5, 9, 1, 2],\n     [2, 6, 3, 5, 2, 8, 1, 4, 2, 2, 5, 3, 5, 7, 4, 1],\n     [5, 5, 5, 5],\n     [5, 6, 7, 8],\n     [8, 7, 7, 6],\n     [6, 7, 10, 7, 6]]\n\nseries |> each((towers: int[]) =>\n    write_line(\"{towers |> join(\", \")} -> {water(towers)}\"))",
  "fullSource": "use IO.Std.write_line\nuse Collections.Iterable\nuse Ghul.Pipes\nuse System.Math\n\nrunning_maxima(heights: Iterable[int]) -> Pipe[int] is\n    let highest mut = 0\n\n    for height in heights do\n        highest = Math.max(highest, height)\n\n        yield highest\n    od\nsi\n\nwater(heights: int[]) -> int => (\n    let left = running_maxima(heights) |> collect_list()\n    let right =\n        running_maxima(heights |> reverse()) |> collect_list()\n    let last = heights.count - 1\n\n    (0..heights.count)\n    |> map(i => Math.min(left[i], right[last - i]) - heights[i])\n    |> reduce(0, (total, depth) => total + depth)\n)\n\nlet series: int[][] =\n    [[1, 5, 3, 7, 2],\n     [5, 3, 7, 2, 6, 4, 5, 9, 1, 2],\n     [2, 6, 3, 5, 2, 8, 1, 4, 2, 2, 5, 3, 5, 7, 4, 1],\n     [5, 5, 5, 5],\n     [5, 6, 7, 8],\n     [8, 7, 7, 6],\n     [6, 7, 10, 7, 6]]\n\nseries |> each((towers: int[]) =>\n    write_line(\"{towers |> join(\", \")} -> {water(towers)}\"))\n",
  "hiddenBefore": false,
  "hiddenAfter": false,
  "hiddenGapsAfterLine": [],
  "output": "1, 5, 3, 7, 2 -> 2\n5, 3, 7, 2, 6, 4, 5, 9, 1, 2 -> 14\n2, 6, 3, 5, 2, 8, 1, 4, 2, 2, 5, 3, 5, 7, 4, 1 -> 35\n5, 5, 5, 5 -> 0\n5, 6, 7, 8 -> 0\n8, 7, 7, 6 -> 0\n6, 7, 10, 7, 6 -> 0\n",
