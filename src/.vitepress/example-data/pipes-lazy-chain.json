{
  "name": "pipes-lazy-chain",
  "code": "let numbers = [1, 2, 3, 4, 5, 6];\n\n// nothing has asked this chain for elements yet, so peek's\n// action has not run\nlet stages = numbers\n    | .peek(x => write_line(\"  pulled {x}\"))\n    | .filter(x => x % 2 == 0)\n    | .map(x => x * 10);\n\nwrite_line(\"chain built - nothing has run yet\");\n\n// collect_list is a terminal, so it asks for the elements\nlet result = stages | .collect_list();\n\nwrite_line(\"result: {result | .join(\", \")}\");",
