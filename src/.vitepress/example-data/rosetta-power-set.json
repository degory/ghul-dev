{
  "name": "rosetta-power-set",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.Iterable;\nuse Collections.List;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// Every subset either leaves the first element out or takes it in, so each element doubles the\n// answer: the power set of the rest, and that same power set with the element added to each.\npower_set[T](values: List[T]) -> LIST[LIST[T]] is\n    if values.count == 0 then\n        let empty: LIST[LIST[T]] = _();\n\n        empty.add(LIST[T]());\n\n        return empty;\n    fi\n\n    let first = values[0];\n    let result: LIST[LIST[T]] = _();\n\n    for subset in power_set(values |> skip(1) |> collect()) do\n        let with_first: LIST[T] = _();\n\n        with_first.add(first);\n        with_first.add_range(subset);\n\n        result.add(subset);\n        result.add(with_first);\n    od\n\n    return result;\nsi\n\nbraced[T](values: Iterable[T]) -> string => \"{{{values |> join(\", \")}}}\";\n\nshow[T](sets: LIST[LIST[T]]) -> string => braced(sets |> map(s => braced(s)));\n\nwrite_line(show(power_set(LIST[int]())));\nwrite_line(show(power_set([1, 2, 3] |> collect())));\nwrite_line(show(power_set([\"a\", \"b\"] |> collect())));",
  "fullSource": "use IO.Std.write_line;\nuse Collections.Iterable;\nuse Collections.List;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// Every subset either leaves the first element out or takes it in, so each element doubles the\n// answer: the power set of the rest, and that same power set with the element added to each.\npower_set[T](values: List[T]) -> LIST[LIST[T]] is\n    if values.count == 0 then\n        let empty: LIST[LIST[T]] = _();\n\n        empty.add(LIST[T]());\n\n        return empty;\n    fi\n\n    let first = values[0];\n    let result: LIST[LIST[T]] = _();\n\n    for subset in power_set(values |> skip(1) |> collect()) do\n        let with_first: LIST[T] = _();\n\n        with_first.add(first);\n        with_first.add_range(subset);\n\n        result.add(subset);\n        result.add(with_first);\n    od\n\n    return result;\nsi\n\nbraced[T](values: Iterable[T]) -> string => \"{{{values |> join(\", \")}}}\";\n\nshow[T](sets: LIST[LIST[T]]) -> string => braced(sets |> map(s => braced(s)));\n\nwrite_line(show(power_set(LIST[int]())));\nwrite_line(show(power_set([1, 2, 3] |> collect())));\nwrite_line(show(power_set([\"a\", \"b\"] |> collect())));\n",
  "hiddenBefore": false,
