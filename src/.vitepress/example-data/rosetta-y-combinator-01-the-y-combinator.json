{
  "name": "rosetta-y-combinator-01-the-y-combinator",
  "snippet": false,
  "code": "use IO.Std.write_line\n\nclass SELF_APPLY[A, B](_f: (SELF_APPLY[A, B]) -> (A -> B)) is\n    apply(r: SELF_APPLY[A, B]) -> (A -> B) => _f(r)\nsi\n\ny[A, B](f: (A -> B) -> (A -> B)) -> (A -> B) =>\n    let wrap =\n        SELF_APPLY[A, B](\n            (r: SELF_APPLY[A, B]) => (a: A) => f(r.apply(r))(a))\n    in wrap.apply(wrap)\n\nlet factorial =\n    y(recurse => n =>\n        if n <= 1 then 1L else cast(n) * recurse(n - 1) fi)\n\nlet fibonacci =\n    y(recurse => n =>\n        if n < 2 then n else recurse(n - 1) + recurse(n - 2) fi)\n\nlet countdown =\n    y(recurse => n =>\n        if n <= 0 then \"liftoff\" else \"{n}, {recurse(n - 1)}\" fi)\n\nlet gcd =\n    y(recurse => ((a, b): (int, int)) =>\n        if b == 0 then a else recurse((b, a % b)) fi)\n\nfor n in 0::10 do\n    write_line(\n        \"factorial({n}) = {factorial(n)}, \"\n        \"fibonacci({n}) = {fibonacci(n)}\")\nod\n\nwrite_line(\"countdown(5) = {countdown(5)}\")\nwrite_line(\"gcd(1071, 462) = {gcd((1071, 462))}\");",
  "fullSource": "use IO.Std.write_line\n\nclass SELF_APPLY[A, B](_f: (SELF_APPLY[A, B]) -> (A -> B)) is\n    apply(r: SELF_APPLY[A, B]) -> (A -> B) => _f(r)\nsi\n\ny[A, B](f: (A -> B) -> (A -> B)) -> (A -> B) =>\n    let wrap =\n        SELF_APPLY[A, B](\n            (r: SELF_APPLY[A, B]) => (a: A) => f(r.apply(r))(a))\n    in wrap.apply(wrap)\n\nlet factorial =\n    y(recurse => n =>\n        if n <= 1 then 1L else cast(n) * recurse(n - 1) fi)\n\nlet fibonacci =\n    y(recurse => n =>\n        if n < 2 then n else recurse(n - 1) + recurse(n - 2) fi)\n\nlet countdown =\n    y(recurse => n =>\n        if n <= 0 then \"liftoff\" else \"{n}, {recurse(n - 1)}\" fi)\n\nlet gcd =\n    y(recurse => ((a, b): (int, int)) =>\n        if b == 0 then a else recurse((b, a % b)) fi)\n\nfor n in 0::10 do\n    write_line(\n        \"factorial({n}) = {factorial(n)}, \"\n        \"fibonacci({n}) = {fibonacci(n)}\")\nod\n\nwrite_line(\"countdown(5) = {countdown(5)}\")\nwrite_line(\"gcd(1071, 462) = {gcd((1071, 462))}\");\n",
  "hiddenBefore": false,
  "hiddenAfter": false,
