  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.LIST;\nuse Ghul.Pipes;\nuse System.Text.StringBuilder;\n\n// this task is about naming conventions, and ghūl has its own, which the compiler\n// warns about breaking: concrete classes are UPPER_SNAKE_CASE, methods and global\n// functions snake_case, and a leading underscore marks a name as non-public\nclass NAME(words: Collections.List[string] private) is\n    to_camel_case() -> string =>\n        _words\n        | .index()\n        | .map(((position, word)) => if position == 0 then _lower_first(word) else _upper_first(word) fi)\n        | .join(\"\");\n\n    to_snake_case() -> string =>\n        _words\n        | .map(word => word.to_lower())\n        | .join(\"_\");\nsi\n\n// a name splits at the boundaries either convention marks: the separators the task\n// allows, and the capital that starts each word after the first in camel case\nparse(text: string) -> NAME is\n    let words = LIST[string]();\n    let word = StringBuilder();\n\n    for c in text.trim() do\n        if c == '_' \\/ c == '-' \\/ c == ' ' then\n            if word.length > 0 then\n                words.add(word.to_string());\n                word.clear();\n            fi\n        elif char.is_upper(c) /\\ word.length > 0 then\n            words.add(word.to_string());\n            word.clear();\n            word.append(c);\n        else\n            word.append(c);\n        fi\n    od\n\n    if word.length > 0 then\n        words.add(word.to_string());\n    fi\n\n    return NAME(words);\nsi\n\n_lower_first(word: string) -> string pure => \"{char.to_lower(word[0])}{word.substring(1)}\";\n\n_upper_first(word: string) -> string pure => \"{char.to_upper(word[0])}{word.substring(1)}\";\n\n_quoted(text: string) -> string pure => \"\\\"{text}\\\"\";\n\nlet tests = [\n    \"snakeCase\",\n    \"snake_case\",\n    \"variable_10_case\",\n    \"variable10Case\",\n    \"ɛrgo rE tHis\",\n    \"hurry-up-joe!\",\n    \"c://my-docs/happy_Flag-Day/12.doc\",\n    \"  spaces  \"\n];\n\nwrite_line(\"{\"input\".pad_right(37)} {\"snake case\".pad_right(37)} camel case\");\n\nfor test in tests do\n    let name = parse(test);\n\n    write_line(\"{_quoted(test).pad_right(37)} {_quoted(name.to_snake_case()).pad_right(37)} {_quoted(name.to_camel_case())}\");\nod",
  "fullSource": "use IO.Std.write_line;\nuse Collections.LIST;\nuse Ghul.Pipes;\nuse System.Text.StringBuilder;\n\n// this task is about naming conventions, and ghūl has its own, which the compiler\n// warns about breaking: concrete classes are UPPER_SNAKE_CASE, methods and global\n// functions snake_case, and a leading underscore marks a name as non-public\nclass NAME(words: Collections.List[string] private) is\n    to_camel_case() -> string =>\n        _words\n        | .index()\n        | .map(((position, word)) => if position == 0 then _lower_first(word) else _upper_first(word) fi)\n        | .join(\"\");\n\n    to_snake_case() -> string =>\n        _words\n        | .map(word => word.to_lower())\n        | .join(\"_\");\nsi\n\n// a name splits at the boundaries either convention marks: the separators the task\n// allows, and the capital that starts each word after the first in camel case\nparse(text: string) -> NAME is\n    let words = LIST[string]();\n    let word = StringBuilder();\n\n    for c in text.trim() do\n        if c == '_' \\/ c == '-' \\/ c == ' ' then\n            if word.length > 0 then\n                words.add(word.to_string());\n                word.clear();\n            fi\n        elif char.is_upper(c) /\\ word.length > 0 then\n            words.add(word.to_string());\n            word.clear();\n            word.append(c);\n        else\n            word.append(c);\n        fi\n    od\n\n    if word.length > 0 then\n        words.add(word.to_string());\n    fi\n\n    return NAME(words);\nsi\n\n_lower_first(word: string) -> string pure => \"{char.to_lower(word[0])}{word.substring(1)}\";\n\n_upper_first(word: string) -> string pure => \"{char.to_upper(word[0])}{word.substring(1)}\";\n\n_quoted(text: string) -> string pure => \"\\\"{text}\\\"\";\n\nlet tests = [\n    \"snakeCase\",\n    \"snake_case\",\n    \"variable_10_case\",\n    \"variable10Case\",\n    \"ɛrgo rE tHis\",\n    \"hurry-up-joe!\",\n    \"c://my-docs/happy_Flag-Day/12.doc\",\n    \"  spaces  \"\n];\n\nwrite_line(\"{\"input\".pad_right(37)} {\"snake case\".pad_right(37)} camel case\");\n\nfor test in tests do\n    let name = parse(test);\n\n    write_line(\"{_quoted(test).pad_right(37)} {_quoted(name.to_snake_case()).pad_right(37)} {_quoted(name.to_camel_case())}\");\nod\n",
