{
  "name": "rosetta-hailstone-sequence",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// Generates a hailstone sequence by applying the Collatz rule until it reaches 1.\nhailstone(n: int) -> Pipe[int] is\n    let current mut = n;\n\n    while true do\n        yield current;\n\n        if current == 1 then\n            return;\n        fi\n\n        current = if current % 2 == 0 then current / 2 else 3 * current + 1 fi;\n    od\nsi\n\n// The Collatz sequence for 27: 112 elements, starting 27, 82, 41, 124 and ending 8, 4, 2, 1.\nlet sequence = hailstone(27) | .collect_list();\nwrite_line(\"length of hailstone(27): {sequence.count}\");\nwrite_line(\"first four: {sequence[0]}, {sequence[1]}, {sequence[2]}, {sequence[3]}\");\nwrite_line(\"last four: {sequence[sequence.count - 4]}, {sequence[sequence.count - 3]}, {sequence[sequence.count - 2]}, {sequence[sequence.count - 1]}\");\n\n// The number under 100,000 with the longest sequence, and that sequence's length.\nlet longest mut = 0;\nlet longest_length mut = 0;\n\nfor n in 1..100_000 do\n    let length = hailstone(n) | .count();\n\n    if length > longest_length then\n        longest = n;\n        longest_length = length;\n    fi\nod\n\nwrite_line(\"longest under 100,000: {longest} (length {longest_length})\");",
  "fullSource": "// expect: warning\nuse IO.Std.write_line;\nuse Collections.LIST;\nuse Ghul.Pipes;\n\n// Generates a hailstone sequence by applying the Collatz rule until it reaches 1.\nhailstone(n: int) -> Pipe[int] is\n    let current mut = n;\n\n    while true do\n        yield current;\n\n        if current == 1 then\n            return;\n        fi\n\n        current = if current % 2 == 0 then current / 2 else 3 * current + 1 fi;\n    od\nsi\n\n// The Collatz sequence for 27: 112 elements, starting 27, 82, 41, 124 and ending 8, 4, 2, 1.\nlet sequence = hailstone(27) | .collect_list();\nwrite_line(\"length of hailstone(27): {sequence.count}\");\nwrite_line(\"first four: {sequence[0]}, {sequence[1]}, {sequence[2]}, {sequence[3]}\");\nwrite_line(\"last four: {sequence[sequence.count - 4]}, {sequence[sequence.count - 3]}, {sequence[sequence.count - 2]}, {sequence[sequence.count - 1]}\");\n\n// The number under 100,000 with the longest sequence, and that sequence's length.\nlet longest mut = 0;\nlet longest_length mut = 0;\n\nfor n in 1..100_000 do\n    let length = hailstone(n) | .count();\n\n    if length > longest_length then\n        longest = n;\n        longest_length = length;\n    fi\nod\n\nwrite_line(\"longest under 100,000: {longest} (length {longest_length})\");\n",
