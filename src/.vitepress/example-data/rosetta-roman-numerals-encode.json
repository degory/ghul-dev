{
  "name": "rosetta-roman-numerals-encode",
  "snippet": false,
  "code": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\n// Largest value first, and the four subtractive pairs sit in the table as values of their own, so\n// taking as many of each as fit needs no special case for them.\nroman(n: int) -> string is\n    let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];\n    let symbols = [\"M\", \"CM\", \"D\", \"CD\", \"C\", \"XC\", \"L\", \"XL\", \"X\", \"IX\", \"V\", \"IV\", \"I\"];\n\n    let numeral = System.Text.StringBuilder();\n    let remaining mut = n;\n\n    for i in 0..values.count do\n        while remaining >= values[i] do\n            numeral.append(symbols[i]);\n\n            remaining = remaining - values[i];\n        od\n    od\n\n    return numeral.to_string();\nsi\n\nfor n in [1990, 2008, 1666, 4, 9, 3999] do\n    write_line(\"{n,4} = {roman(n)}\");\nod",
  "fullSource": "use IO.Std.write_line;\nuse Ghul.Pipes;\n\n// Largest value first, and the four subtractive pairs sit in the table as values of their own, so\n// taking as many of each as fit needs no special case for them.\nroman(n: int) -> string is\n    let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];\n    let symbols = [\"M\", \"CM\", \"D\", \"CD\", \"C\", \"XC\", \"L\", \"XL\", \"X\", \"IX\", \"V\", \"IV\", \"I\"];\n\n    let numeral = System.Text.StringBuilder();\n    let remaining mut = n;\n\n    for i in 0..values.count do\n        while remaining >= values[i] do\n            numeral.append(symbols[i]);\n\n            remaining = remaining - values[i];\n        od\n    od\n\n    return numeral.to_string();\nsi\n\nfor n in [1990, 2008, 1666, 4, 9, 3999] do\n    write_line(\"{n,4} = {roman(n)}\");\nod\n",
  "hiddenBefore": false,
  "hiddenAfter": false,
